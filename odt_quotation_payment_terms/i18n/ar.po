#. module: odt_quotation_payment_terms
#: model:ir.model,name:odt_quotation_payment_terms.model_sale_order_line
msgid "Sales Order Line"
msgstr "بند أمر المبيعات"

#. module: odt_quotation_payment_terms
#: model:ir.model.fields,field_description:odt_quotation_payment_terms.field_sale_order__send_approval_date
msgid "Sending Approval Date"
msgstr "تاريخ اعتماد الإرسال"

#. module: odt_quotation_payment_terms
#: model:ir.model.fields,field_description:odt_quotation_payment_terms.field_sale_order__send_approved_by_id
msgid "Sending Approved By"
msgstr "الإرسال معتمد من"

#. module: odt_quotation_payment_terms
#: model:ir.model.fields,field_description:odt_quotation_payment_terms.field_sale_order__is_send_approval_needed
msgid "Sending Needs Approval"
msgstr "الإرسال يحتاج إلى اعتماد"

#. module: odt_quotation_payment_terms
#: model:ir.model.fields,help:odt_quotation_payment_terms.field_res_company__special_min_advance
msgid ""
"Smallest advance, from 0 to 100%, a payment term must carry for a quotation "
"holding a special item to be sent. 0 means no minimum."
msgstr ""
"أقل دفعة مقدمة، من 0 إلى 100%، يجب أن يتضمنها شرط الدفع حتى يُرسل عرض سعر "
"يتضمن صنفًا خاصًا. القيمة 0 تعني عدم وجود حد أدنى."

#. module: odt_quotation_payment_terms
#: model:ir.model.fields,field_description:odt_quotation_payment_terms.field_purchase_order_line__is_special
#: model:ir.model.fields,field_description:odt_quotation_payment_terms.field_sale_order_line__is_special
msgid "Special Item"
msgstr "صنف خاص"

#. module: odt_quotation_payment_terms
#: model:ir.model.fields,field_description:odt_quotation_payment_terms.field_res_company__special_min_advance
msgid "Special Items Minimum Advance (%)"
msgstr "الحد الأدنى للدفعة المقدمة للأصناف الخاصة (%)"

#. module: odt_quotation_payment_terms
#: model:ir.model.fields,help:odt_quotation_payment_terms.field_sale_order__is_send_approval_needed
msgid ""
"The customer is on the credit watch list and sending the quotation has not "
"been approved yet."
msgstr "العميل على قائمة المراقبة الائتمانية ولم يُعتمد إرسال عرض السعر بعد."

#. module: odt_quotation_payment_terms
#: model_terms:ir.ui.view,arch_db:odt_quotation_payment_terms.view_order_form_inherit_quotation_payment_terms
msgid ""
"The customer is on the credit watch list: the Operations Manager or the "
"Finance Manager must approve sending this quotation."
msgstr ""
"العميل على قائمة المراقبة الائتمانية: يجب أن يعتمد مدير العمليات أو المدير "
"المالي إرسال عرض السعر هذا."

#. module: odt_quotation_payment_terms
#: model:ir.model.fields,help:odt_quotation_payment_terms.field_purchase_order_line__is_special
msgid ""
"The product is a special item, as on the sales order line the purchase was "
"raised for."
msgstr "المنتج صنف خاص، كما في بند أمر البيع الذي أُنشئ الشراء من أجله."

#. module: odt_quotation_payment_terms
#: model:ir.model.fields,help:odt_quotation_payment_terms.field_sale_order_line__is_special
msgid ""
"The product is a special item: its quotation needs the company's special-"
"item minimum advance."
msgstr ""
"المنتج صنف خاص: يحتاج عرض سعره إلى الحد الأدنى للدفعة المقدمة للأصناف الخاصة"
" في الشركة."

#. module: odt_quotation_payment_terms
#: model:ir.model.fields,help:odt_quotation_payment_terms.field_sale_order__is_term_approval_needed
msgid ""
"The quotation's payment term is not the customer's default and the Finance "
"Manager has not approved it yet."
msgstr ""
"شرط دفع عرض السعر ليس الشرط الافتراضي للعميل ولم يعتمده المدير المالي بعد."

#. module: odt_quotation_payment_terms
#. odoo-python
#: code:addons/odt_quotation_payment_terms/models/res_company.py:0
msgid "The special items minimum advance is between 0 and 100%."
msgstr "الحد الأدنى للدفعة المقدمة للأصناف الخاصة بين 0 و100%."

#. module: odt_quotation_payment_terms
#: model_terms:ir.ui.view,arch_db:odt_quotation_payment_terms.view_order_form_inherit_quotation_payment_terms
msgid ""
"This payment term is not the customer's default: the Finance Manager must "
"approve it before the quotation is sent."
msgstr ""
"شرط الدفع هذا ليس الشرط الافتراضي للعميل: يجب أن يعتمده المدير المالي قبل "
"إرسال عرض السعر."

#. module: odt_quotation_payment_terms
#: model:ir.model.fields,help:odt_quotation_payment_terms.field_sale_order__send_approval_date
msgid "When sending to the watch-listed customer was approved."
msgstr "وقت اعتماد الإرسال إلى العميل المدرج على قائمة المراقبة."

#. module: odt_quotation_payment_terms
#: model:ir.model.fields,help:odt_quotation_payment_terms.field_sale_order__term_approval_date
msgid "When the payment term was approved."
msgstr "وقت اعتماد شرط الدفع."
