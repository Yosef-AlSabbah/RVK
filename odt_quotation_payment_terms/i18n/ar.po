msgstr "بند أمر الشراء"

#. module: odt_quotation_payment_terms
#: model:res.groups.privilege,name:odt_quotation_payment_terms.res_groups_privilege_quotation_approval
msgid "Quotation Approval"
msgstr "اعتماد عروض الأسعار"

#. module: odt_quotation_payment_terms
#: model_terms:ir.ui.view,arch_db:odt_quotation_payment_terms.view_order_form_inherit_quotation_payment_terms
msgid "Quotation Approvals"
msgstr "اعتمادات عرض السعر"

#. module: odt_quotation_payment_terms
#: model:res.groups,name:odt_quotation_payment_terms.group_send_approver
msgid "Quotation Send Approver"
