#. module: odt_quotation_payment_terms
#. odoo-python
#: code:addons/odt_quotation_payment_terms/models/sale_order.py:0
msgid ""
"%(customer)s is on the credit watch list: the Operations Manager or the "
"Finance Manager must approve sending %(order)s."
msgstr ""
"العميل %(customer)s على قائمة المراقبة الائتمانية: يجب أن يعتمد مدير "
"العمليات أو المدير المالي إرسال %(order)s."

#. module: odt_quotation_payment_terms
#. odoo-python
#: code:addons/odt_quotation_payment_terms/models/sale_order.py:0
msgid ""
"%(order)s holds special items, which need a payment term with at least "
"%(minimum)s%% advance; %(term)s has %(advance)s%%. Choose a term with at "
"least %(minimum)s%% advance."
msgstr ""
"يتضمن %(order)s أصنافًا خاصة تتطلب شرط دفع بدفعة مقدمة لا تقل عن "
"%(minimum)s%%؛ وشرط %(term)s دفعته المقدمة %(advance)s%%. اختر شرطًا بدفعة "
"مقدمة لا تقل عن %(minimum)s%%."

#. module: odt_quotation_payment_terms
#. odoo-python
#: code:addons/odt_quotation_payment_terms/models/sale_order.py:0
msgid ""
"%(order)s is on %(term)s, which is not the customer's default payment term: "
"the Finance Manager must approve it on the quotation before it is sent."
msgstr ""
"عرض السعر %(order)s على شرط الدفع %(term)s، وهو ليس شرط الدفع الافتراضي "
"للعميل: يجب أن يعتمده المدير المالي على عرض السعر قبل إرساله."

#. module: odt_quotation_payment_terms
#. odoo-python
#: code:addons/odt_quotation_payment_terms/models/sale_order.py:0
msgid "%s does not need a payment term approval."
msgstr "لا يحتاج %s إلى اعتماد شرط الدفع."

#. module: odt_quotation_payment_terms
#. odoo-python
#: code:addons/odt_quotation_payment_terms/models/sale_order.py:0
msgid "%s does not need a sending approval."
msgstr "لا يحتاج %s إلى اعتماد الإرسال."

#. module: odt_quotation_payment_terms
#. odoo-python
#: code:addons/odt_quotation_payment_terms/models/sale_order.py:0
msgid ""
"%s has no payment term: select the payment term agreed with the customer "
"before sending the quotation."
msgstr ""
"لا يوجد شرط دفع في %s: اختر شرط الدفع المتفق عليه مع العميل قبل إرسال عرض "
"السعر."

#. module: odt_quotation_payment_terms
#: model_terms:ir.ui.view,arch_db:odt_quotation_payment_terms.view_order_form_inherit_quotation_payment_terms
msgid "Approve Payment Term"
msgstr "اعتماد شرط الدفع"

#. module: odt_quotation_payment_terms
#: model_terms:ir.ui.view,arch_db:odt_quotation_payment_terms.view_order_form_inherit_quotation_payment_terms
msgid "Approve Sending"
msgstr "اعتماد الإرسال"

#. module: odt_quotation_payment_terms
#: model:res.groups,comment:odt_quotation_payment_terms.group_send_approver
msgid ""
"Approves sending quotations to customers on the credit watch list (the "
"Operations Manager and the Finance Manager)."
msgstr ""
"يعتمد إرسال عروض الأسعار إلى العملاء على قائمة المراقبة الائتمانية (مدير "
"العمليات والمدير المالي)."

#. module: odt_quotation_payment_terms
#: model:ir.model,name:odt_quotation_payment_terms.model_res_company
msgid "Companies"
msgstr "الشركات"

