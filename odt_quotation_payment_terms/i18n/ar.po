#: model:ir.model.fields,field_description:odt_quotation_payment_terms.field_sale_order_line__display_name
msgid "Display Name"
msgstr "اسم العرض"

#. module: odt_quotation_payment_terms
#: model:ir.model.fields,help:odt_quotation_payment_terms.field_sale_order__term_approved_by_id
msgid ""
"Finance Manager who approved a payment term other than the customer's "
"default on this quotation."
msgstr ""
"المدير المالي الذي اعتمد على عرض السعر هذا شرط دفع غير الشرط الافتراضي "
"للعميل."

#. module: odt_quotation_payment_terms
#: model:ir.model.fields,field_description:odt_quotation_payment_terms.field_purchase_order_line__id
#: model:ir.model.fields,field_description:odt_quotation_payment_terms.field_res_company__id
#: model:ir.model.fields,field_description:odt_quotation_payment_terms.field_sale_order__id
#: model:ir.model.fields,field_description:odt_quotation_payment_terms.field_sale_order_line__id
msgid "ID"
msgstr "المُعرف"

#. module: odt_quotation_payment_terms
#. odoo-python
#: code:addons/odt_quotation_payment_terms/models/sale_order.py:0
msgid "Only the Finance Manager can approve a quotation's payment term."
msgstr "لا يعتمد شرط دفع عرض السعر إلا المدير المالي."

#. module: odt_quotation_payment_terms
#. odoo-python
#: code:addons/odt_quotation_payment_terms/models/sale_order.py:0
msgid ""
"Only the Operations Manager or the Finance Manager can approve sending a "
"quotation to a customer on the credit watch list."
msgstr ""
"لا يعتمد إرسال عرض سعر إلى عميل على قائمة المراقبة الائتمانية إلا مدير "
"العمليات أو المدير المالي."

#. module: odt_quotation_payment_terms
#: model:ir.model.fields,help:odt_quotation_payment_terms.field_sale_order__send_approved_by_id
msgid ""
"Operations or Finance Manager who approved sending this quotation to a "
"customer on the credit watch list."
msgstr ""
"مدير العمليات أو المدير المالي الذي اعتمد إرسال عرض السعر هذا إلى عميل على "
"قائمة المراقبة الائتمانية."

#. module: odt_quotation_payment_terms
#: model:ir.model.fields,field_description:odt_quotation_payment_terms.field_sale_order__term_approval_date
msgid "Payment Term Approval Date"
msgstr "تاريخ اعتماد شرط الدفع"

#. module: odt_quotation_payment_terms
#: model:ir.model.fields,field_description:odt_quotation_payment_terms.field_sale_order__term_approved_by_id
