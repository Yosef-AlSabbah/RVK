<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_quotation_approval" model="res.groups.privilege">
        <field name="name">Quotation Approval</field>
        <field name="sequence">2</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>

    <record id="group_send_approver" model="res.groups">
        <field name="name">Quotation Send Approver</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_quotation_approval"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="comment">Approves sending quotations to customers on the credit watch list (the Operations Manager and the Finance Manager).</field>
    </record>
</odoo>
