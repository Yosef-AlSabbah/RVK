<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_customer_credit_control" model="ir.ui.view">
        <field name="name">res.company.view.form.inherit.customer.credit.control</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_info']" position="after">
                <page string="Credit Control" name="credit_control" groups="account.group_account_manager">
                    <group>
                        <group>
                            <field name="credit_ceiling"/>
                            <field name="hold_days"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
