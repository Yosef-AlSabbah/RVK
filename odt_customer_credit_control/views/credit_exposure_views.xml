<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="credit_exposure_view_list" model="ir.ui.view">
        <field name="name">credit.exposure.view.list</field>
        <field name="model">credit.exposure</field>
        <field name="arch" type="xml">
            <list string="Monthly Credit Exposure" create="0" edit="0" delete="0">
                <field name="month"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="partner_id"/>
                <field name="credit_sales" sum="Total"/>
                <field name="credit_ceiling"/>
                <field name="share_pct" widget="progressbar"/>
                <field name="cap_pct"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="credit_exposure_view_form" model="ir.ui.view">
        <field name="name">credit.exposure.view.form</field>
        <field name="model">credit.exposure</field>
        <field name="arch" type="xml">
            <form string="Monthly Credit Exposure" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="month"/>
                        </group>
                        <group>
                            <field name="credit_sales"/>
                            <field name="credit_ceiling"/>
                            <field name="share_pct"/>
                            <field name="cap_pct"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="credit_exposure_view_search" model="ir.ui.view">
        <field name="name">credit.exposure.view.search</field>
        <field name="model">credit.exposure</field>
        <field name="arch" type="xml">
            <search string="Monthly Credit Exposure">
                <field name="partner_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter string="This Month" name="this_month" domain="[('month', '=', context_today().strftime('%Y-%m-01'))]"/>
                <separator/>
                <filter string="Over Cap" name="over_cap" domain="[('cap_pct', '>', 0)]"/>
                <group>
                    <filter string="Month" name="group_month" context="{'group_by': 'month'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
                    <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="credit_exposure_action" model="ir.actions.act_window">
        <field name="name">Monthly Credit Exposure</field>
        <field name="res_model">credit.exposure</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_this_month': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No credit sales this month</p>
            <p>Each customer's confirmed credit sales of the month appear here, with their share of the company's monthly credit ceiling and their cap.</p>
        </field>
    </record>

    <menuitem
        id="credit_exposure_menu"
        name="Credit Exposure"
        parent="sale.menu_sale_report"
        action="credit_exposure_action"
        sequence="40"
        groups="sales_team.group_sale_salesman,account.group_account_manager"/>
</odoo>
