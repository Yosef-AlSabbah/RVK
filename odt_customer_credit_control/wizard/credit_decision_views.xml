<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="credit_decision_view_form" model="ir.ui.view">
        <field name="name">credit.decision.view.form</field>
        <field name="model">credit.decision</field>
        <field name="arch" type="xml">
            <form string="Credit Decision">
                <group>
                    <field name="decision" readonly="1" force_save="1"/>
                    <field name="partner_ids" widget="many2many_tags" readonly="1" invisible="not partner_ids"/>
                    <field name="order_ids" widget="many2many_tags" readonly="1" invisible="not order_ids"/>
                    <field name="reason" placeholder="Why, as it will be recorded"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Confirm" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="credit_decision_action" model="ir.actions.act_window">
        <field name="name">Credit Decision</field>
        <field name="res_model">credit.decision</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="help" type="html">
            <p>Record a credit decision for the selected customers or orders, with its reason.</p>
        </field>
    </record>
</odoo>
